# -----------------------------------------------
# Environment Variables — copy to .env and fill in
# -----------------------------------------------

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Default is SQLite (no setup needed)
# To switch to PostgreSQL: postgresql+psycopg2://user:password@localhost/dbname
DATABASE_URL=sqlite:///./zorvyn.db

# App
APP_ENV=development